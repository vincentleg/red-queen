# Use the official MongoDB Atlas hackathon Sandbox connection string.
# Server-only. Never prefix credentials with NEXT_PUBLIC_.
MONGODB_URI=mongodb+srv://<username>:<password>@<sandbox-host>/?retryWrites=true&w=majority
MONGODB_DB=red_queen
# Preferred: create a key at https://aistudio.google.com/apikey on a Free-tier project.
# Keep billing disabled. Uses gemini-2.5-flash; takes precedence over Anthropic.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional Anthropic model override; defaults to claude-opus-5-5
RED_QUEEN_MODEL=
